        <mxCell id="w_rf_csi" value="Sóng ESP-NOW 2.4 GHz&#10;(100 Hz CSI Multipath)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.7407;exitDx=0;exitDy=0;entryX=0;entryY=0.6897;entryDx=0;entryDy=0;endArrow=block;endSize=8;dashed=1;strokeWidth=2;strokeColor=#0066cc;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="mcu1" target="mcu2">
