<mxfile host="drawio" version="26.0.0">
  <diagram id="ai-pipeline" name="AI-RuleChain-Pipeline">
    <mxGraphModel dx="1600" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="730" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        
        <mxCell id="band1" value="GIAI ĐOẠN 1: TIỀN XỬ LÝ TÍN HIỆU VÔ TUYẾN CSI &amp; SUY LUẬN TINYML TẠI BIÊN (ESP32-S3 NODE RX — T04, T05, T06)" style="swimlane;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;pointerEvents=0;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1480" height="190" as="geometry" />
        </mxCell>
        <mxCell id="s1_raw" value="&lt;b&gt;1. Thu Ma trận CSI Thô (100 Hz)&lt;/b&gt;&#10;H_k(t) = I_k(t) + j·Q_k(t) từ tầng PHY&#10;Loại bỏ sóng mang Null/Pilot → Giữ 52 kênh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="band1">
          <mxGeometry x="30" y="55" width="310" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s1_filt" value="&lt;b&gt;2. Tính Biên độ &amp; Khử Nhiễu Số&lt;/b&gt;&#10;|H_k(t)| = sqrt(I_k² + Q_k²) + Bù nhiệt ẩm DHT20&#10;Lọc Hampel (k=5) + Butterworth (0.2–15 Hz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="band1">
          <mxGeometry x="400" y="55" width="310" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s1_win" value="&lt;b&gt;3. Cửa sổ Trượt &amp; Trích xuất Đặc trưng&lt;/b&gt;&#10;Cửa sổ T_w = 2.0 giây (200 khung × 52 kênh)&#10;Tính Mean, Variance, Doppler Energy, Max-Drop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="band1">
          <mxGeometry x="770" y="55" width="310" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s1_tiny" value="&lt;b&gt;4. Suy luận Edge TinyML (INT8 1D-CNN)&lt;/b&gt;&#10;Chạy TFLite Micro trực tiếp trên ESP32-S3 (&lt;18 ms)&#10;Phân loại: Empty / Stationary / Walking / Fall [T04]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="band1">
          <mxGeometry x="1140" y="55" width="310" height="105" as="geometry" />
        </mxCell>

        
        <mxCell id="band2" value="GIAI ĐOẠN 2: XÁC THỰC CHÉO AI TRÊN GPU &amp; HỢP NHẤT ĐỊNH DANH BLE TẠI PC LOCAL GATEWAY (T03, T08, T09, T10, N04)" style="swimlane;startSize=36;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;pointerEvents=0;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="265" width="1480" height="190" as="geometry" />
        </mxCell>
        <mxCell id="s2_mqtt" value="&lt;b&gt;8. Đóng gói JSON &amp; Đồng bộ Gateway&lt;/b&gt;&#10;Đẩy gói Telemetry + Event lên CoreIOT [T08, T15]&#10;Topic: v1/gateway/telemetry (MQTT TLS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=11;" vertex="1" parent="band2">
          <mxGeometry x="30" y="55" width="310" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s2_ble" value="&lt;b&gt;7. Hợp nhất Định danh BLE [T03]&lt;/b&gt;&#10;Kiểm tra Whitelist MAC &amp; RSSI &gt; -75 dBm&#10;Gắn cờ xác thực: ble_authorized = True / False" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="band2">
          <mxGeometry x="400" y="55" width="310" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s2_gpu" value="&lt;b&gt;6. Suy luận 2D-CNN trên GPU [T09, N04]&lt;/b&gt;&#10;Tăng tốc bằng ONNX Runtime + CUDA GPU&#10;Xác thực chéo độ tin cậy P(Fall) &amp; P(Walking)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="band2">
          <mxGeometry x="770" y="55" width="310" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s2_stft" value="&lt;b&gt;5. Biến đổi Phổ STFT Spectrogram&lt;/b&gt;&#10;Tạo Bản đồ nhiệt Thời gian–Tần số (64×64×3)&#10;Hiển thị trực tiếp lên Local UI Streamlit [T10]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="band2">
          <mxGeometry x="1140" y="55" width="310" height="105" as="geometry" />
        </mxCell>

        
        <mxCell id="band3" value="GIAI ĐOẠN 3: KỊCH BẢN TỰ ĐỘNG HÓA COREIOT RULECHAIN, CẢNH BÁO ĐA KÊNH &amp; ĐIỀU KHIỂN NGƯỢC (T11, T12, T13, T14)" style="swimlane;startSize=36;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;pointerEvents=0;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="1480" height="190" as="geometry" />
        </mxCell>
        <mxCell id="s3_rule" value="&lt;b&gt;9. Bộ Phân loại Sự kiện RuleChain [T12]&lt;/b&gt;&#10;Đánh giá biểu thức điều kiện Script Node&#10;trên luồng JSON Telemetry từ Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="band3">
          <mxGeometry x="30" y="55" width="310" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s3_fall" value="&lt;b&gt;10A. Kịch bản CẤP CỨU TÉ NGÃ&lt;/b&gt;&#10;[state == 'FALL' &amp; confidence &gt;= 0.85]&#10;Tạo Critical Alarm + Bật Còi SOS Khẩn cấp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="band3">
          <mxGeometry x="400" y="55" width="310" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s3_intr" value="&lt;b&gt;10B. Kịch bản CẢNH BÁO XÂM NHẬP&lt;/b&gt;&#10;[state == 'WALKING' &amp; ble_auth == False]&#10;Tạo Major Security Alarm + Bật Đèn Cảnh báo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="band3">
          <mxGeometry x="770" y="55" width="310" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s3_act" value="&lt;b&gt;11. Cảnh báo Telegram &amp; Dashboard&lt;/b&gt;&#10;Bắn thông báo Telegram Bot / Email tức thời [T13]&#10;Cập nhật CoreIOT Dashboard [T11] &amp; Lưu Log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;" vertex="1" parent="band3">
          <mxGeometry x="1140" y="55" width="310" height="105" as="geometry" />
        </mxCell>

        
        <mxCell id="ep1" value="52 kênh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#6c8ebf;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="s1_raw" target="s1_filt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep2" value="|H_k(t)| sạch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#6c8ebf;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="s1_filt" target="s1_win">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep3" value="Tensor 200×52" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#6c8ebf;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="s1_win" target="s1_tiny">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        
        <mxCell id="ep4" value="USB-CDC 921600 bps (CSI + Nhãn Biên)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#82b366;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="s1_tiny" target="s2_stft">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        
        <mxCell id="ep5" value="Ảnh Phổ 64×64" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#82b366;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="s2_stft" target="s2_gpu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep6" value="Nhãn AI + P(y)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#82b366;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="s2_gpu" target="s2_ble">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep7" value="Sự kiện Hợp nhất" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#82b366;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="s2_ble" target="s2_mqtt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        
        <mxCell id="ep8" value="MQTT Telemetry JSON (Internet / TLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#9673a6;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="s2_mqtt" target="s3_rule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        
        <mxCell id="ep9" value="Ngã" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#b85450;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="s3_rule" target="s3_fall">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep10" value="Chuyển tiếp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#d79b00;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="s3_fall" target="s3_intr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep11" value="Kích hoạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#b85450;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="s3_intr" target="s3_act">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>