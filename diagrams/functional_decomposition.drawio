        </mxCell>
        <mxCell id="f03" value="&lt;b&gt;F03: Quét Định danh BLE&lt;/b&gt;&#10;Thu thập MAC &amp; RSSI từ Beacon&#10;phân biệt Người nhà / Kẻ lạ [T03]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
