        </mxCell>
        <mxCell id="f04" value="&lt;b&gt;F04: Suy luận TinyML 1D-CNN&lt;/b&gt;&#10;Phân loại Empty / Stationary /&#10;Walking / Fall trên ESP32-S3 [T04, T05]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
