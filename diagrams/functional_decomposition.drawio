        <mxCell id="sub4" value="&lt;b&gt;4. Trạm Local IoT Gateway&lt;/b&gt;&#10;(PC Gateway, GPU AI &amp; Local UI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
