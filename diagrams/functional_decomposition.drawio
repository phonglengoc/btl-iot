        <mxCell id="f05" value="&lt;b&gt;F05: Web Server Nhúng&lt;/b&gt;&#10;Hiển thị trạng thái &amp; tinh chỉnh&#10;ngưỡng nhạy trực tiếp trên mạch [T07]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
