        <mxCell id="sub3" value="&lt;b&gt;3. Giao diện &amp; Báo động Tại chỗ&lt;/b&gt;&#10;(Embedded Web &amp; Local Alarm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
