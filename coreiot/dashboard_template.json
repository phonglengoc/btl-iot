{
  "title": "HCMUT IoT HK261 - Smart Fall Detection & Room Monitoring Dashboard",
  "configuration": {
    "description": "Remote Monitoring, DHT20 Environment, Gateway AI Fall Detection & Buzzer RPC Control (T11, T12, T13, T15)",
    "entityAliases": {
      "alias_node2_rx": {
        "id": "alias_node2_rx",
        "alias": "YoloUNO Node 2 (CSI Rx & Alarm)",
        "filter": {
          "type": "singleEntity",
          "resolveMultiple": false,
          "singleEntity": {
            "entityType": "DEVICE",
            "id": "00000000-0000-0000-0000-000000000002"
          }
        }
      },
      "alias_node1_tx": {
        "id": "alias_node1_tx",
        "alias": "YoloUNO Node 1 (ESP-NOW Tx & DHT20)",
        "filter": {
          "type": "singleEntity",
          "resolveMultiple": false,
          "singleEntity": {
            "entityType": "DEVICE",
            "id": "00000000-0000-0000-0000-000000000001"
          }
        }
      }
    },
    "widgets": {
      "w_safety_card": {
        "isSystemType": true,
        "bundleAlias": "cards",
        "typeAlias": "simple_card",
        "type": "latest",
        "title": "1. Trạng thái Phòng & Phân loại Té ngã AI (T09)",
        "sizeX": 8,
        "sizeY": 4,
        "row": 0,
        "col": 0,
        "config": {
          "datasources": [
            {
              "type": "entity",
              "entityAliasId": "alias_node2_rx",
              "dataKeys": [
                {"name": "csi_state", "type": "timeseries", "label": "Trạng thái AI (Random Forest)"},
                {"name": "ai_conf", "type": "timeseries", "label": "Độ tin cậy AI"},
                {"name": "signal_std", "type": "timeseries", "label": "Độ lệch chuẩn sóng CSI (Std)"},
                {"name": "signal_range", "type": "timeseries", "label": "Biên độ dao động (Max - Min)"}
              ]
            }
          ]
        }
      },
      "w_env_card": {
        "isSystemType": true,
        "bundleAlias": "cards",
        "typeAlias": "simple_card",
        "type": "latest",
        "title": "2. Cảm biến Môi trường I2C DHT20 & Kênh ESP-NOW (T01, T06)",
        "sizeX": 8,
        "sizeY": 4,
        "row": 0,
        "col": 8,
        "config": {
          "datasources": [
            {
              "type": "entity",
              "entityAliasId": "alias_node1_tx",
              "dataKeys": [
                {"name": "room_temp_c", "type": "timeseries", "label": "Nhiệt độ phòng (°C)", "units": "°C"},
                {"name": "room_humi_rh", "type": "timeseries", "label": "Độ ẩm tương đối (%RH)", "units": "%"},
                {"name": "pkt_loss_pct", "type": "timeseries", "label": "Tỷ lệ mất gói ESP-NOW (%)", "units": "%"}
              ]
            }
          ]
        }
      },
      "w_timeseries_ai": {
        "isSystemType": true,
        "bundleAlias": "charts",
        "typeAlias": "basic_timeseries",
        "type": "timeseries",
        "title": "3. Đồ thị Dao động Sóng CSI & Độ tin cậy AI theo Thời gian thực",
        "sizeX": 16,
        "sizeY": 6,
        "row": 4,
        "col": 0,
        "config": {
          "timewindow": {"realtime": {"timewindowMs": 120000, "interval": 1000}},
          "datasources": [
            {
              "type": "entity",
              "entityAliasId": "alias_node2_rx",
              "dataKeys": [
                {"name": "signal_std", "type": "timeseries", "label": "Độ lệch chuẩn sóng (Std)"},
                {"name": "signal_range", "type": "timeseries", "label": "Biên độ (Max - Min)"},
                {"name": "ai_conf", "type": "timeseries", "label": "Độ tin cậy AI"}
              ]
            }
          ]
        }
      },
      "w_rpc_alarm_switch": {
        "isSystemType": true,
        "bundleAlias": "gpio_widgets",
        "typeAlias": "basic_gpio_control",
        "type": "rpc",
        "title": "4. Điều khiển RPC Từ xa: Bật / Tắt Còi Báo động (T08, T11)",
        "sizeX": 8,
        "sizeY": 5,
        "row": 10,
        "col": 0,
        "config": {
          "targetDeviceAliasIds": ["alias_node2_rx"],
          "requestTimeout": 2000,
          "switchPanelObjects": [
            {"name": "Còi Báo động Buzzer (GPIO10)", "method": "setAlarm"}
          ]
        }
      },
      "w_alarms_table": {
        "isSystemType": true,
        "bundleAlias": "alarm_widgets",
        "typeAlias": "alarms_table",
        "type": "alarm",
        "title": "5. Nhật ký Cảnh báo Khẩn cấp Té ngã & SOS (T12, T13)",
        "sizeX": 8,
        "sizeY": 5,
        "row": 10,
        "col": 8,
        "config": {
          "alarmSource": {
            "type": "entity",
            "entityAliasId": "alias_node2_rx",
            "dataKeys": [
              {"name": "createdTime", "type": "alarm", "label": "Thời gian"},
              {"name": "type", "type": "alarm", "label": "Loại cảnh báo"},
              {"name": "severity", "type": "alarm", "label": "Mức độ"},
              {"name": "status", "type": "alarm", "label": "Trạng thái"}
            ]
          }
        }
      }
    }
  }
}
