{
  "title": "HCMUT IoT HK261 - Smart Fall Detection & Room Monitoring Dashboard",
  "configuration": {
    "description": "Remote Monitoring, DHT20 Environment, Gateway AI Fall Detection & Buzzer RPC Control (T11, T12, T13, T15)",
    "entityAliases": {
      "alias_node2_rx": {
        "id": "alias_node2_rx",
        "alias": "YoloUNO Node 2 (CSI Rx & Alarm)",
        "filter": {
          "type": "singleEntity",
          "resolveMultiple": false,
          "singleEntity": {
            "entityType": "DEVICE",
            "id": "00000000-0000-0000-0000-000000000002"
          }
        }
      },
      "alias_node1_tx": {
        "id": "alias_node1_tx",
        "alias": "YoloUNO Node 1 (ESP-NOW Tx & DHT20)",
        "filter": {
          "type": "singleEntity",
          "resolveMultiple": false,
          "singleEntity": {
            "entityType": "DEVICE",
            "id": "00000000-0000-0000-0000-000000000001"
          }
        }
      }
    },
    "widgets": {
      "w_safety_card": {
        "isSystemType": true,
        "bundleAlias": "cards",
        "typeAlias": "simple_card",
        "type": "latest",
        "title": "1. Room Status & AI Fall Classification (T09)",
        "sizeX": 8,
        "sizeY": 4,
        "row": 0,
        "col": 0,
        "config": {
          "datasources": [
            {
              "type": "entity",
              "entityAliasId": "alias_node2_rx",
              "dataKeys": [
                {"name": "csi_state", "type": "timeseries", "label": "AI State (Random Forest)"},
                {"name": "ai_conf", "type": "timeseries", "label": "AI Confidence"},
                {"name": "signal_std", "type": "timeseries", "label": "CSI Signal Std"},
                {"name": "signal_range", "type": "timeseries", "label": "Peak-to-Peak (Max - Min)"}
              ]
            }
          ]
        }
      },
      "w_env_card": {
        "isSystemType": true,
        "bundleAlias": "cards",
        "typeAlias": "simple_card",
        "type": "latest",
        "title": "2. I2C DHT20 Environment & ESP-NOW Link (T01, T06)",
        "sizeX": 8,
        "sizeY": 4,
        "row": 0,
        "col": 8,
        "config": {
          "datasources": [
            {
              "type": "entity",
              "entityAliasId": "alias_node1_tx",
              "dataKeys": [
                {"name": "room_temp_c", "type": "timeseries", "label": "Room Temperature (°C)", "units": "°C"},
                {"name": "room_humi_rh", "type": "timeseries", "label": "Relative Humidity (%RH)", "units": "%"},
                {"name": "pkt_loss_pct", "type": "timeseries", "label": "ESP-NOW Packet Loss (%)", "units": "%"}
              ]
            }
          ]
        }
      },
      "w_timeseries_ai": {
        "isSystemType": true,
        "bundleAlias": "charts",
        "typeAlias": "basic_timeseries",
        "type": "timeseries",
        "title": "3. Real-Time CSI Fluctuation & AI Confidence Chart",
        "sizeX": 16,
        "sizeY": 6,
        "row": 4,
        "col": 0,
        "config": {
          "timewindow": {"realtime": {"timewindowMs": 120000, "interval": 1000}},
          "datasources": [
            {
              "type": "entity",
              "entityAliasId": "alias_node2_rx",
              "dataKeys": [
                {"name": "signal_std", "type": "timeseries", "label": "CSI Signal Std"},
                {"name": "signal_range", "type": "timeseries", "label": "Peak-to-Peak (Max - Min)"},
                {"name": "ai_conf", "type": "timeseries", "label": "AI Confidence"}
              ]
            }
          ]
        }
      },
      "w_rpc_alarm_switch": {
        "isSystemType": true,
        "bundleAlias": "gpio_widgets",
        "typeAlias": "basic_gpio_control",
        "type": "rpc",
        "title": "4. Remote RPC Control: Buzzer Alarm ON / OFF (T08, T11)",
        "sizeX": 8,
        "sizeY": 5,
        "row": 10,
        "col": 0,
        "config": {
          "targetDeviceAliasIds": ["alias_node2_rx"],
          "requestTimeout": 2000,
          "switchPanelObjects": [
            {"name": "Buzzer Alarm (GPIO10)", "method": "setAlarm"}
          ]
        }
      },
      "w_alarms_table": {
        "isSystemType": true,
        "bundleAlias": "alarm_widgets",
        "typeAlias": "alarms_table",
        "type": "alarm",
        "title": "5. Emergency Fall & SOS Alarm Log (T12, T13)",
        "sizeX": 8,
        "sizeY": 5,
        "row": 10,
        "col": 8,
        "config": {
          "alarmSource": {
            "type": "entity",
            "entityAliasId": "alias_node2_rx",
            "dataKeys": [
              {"name": "createdTime", "type": "alarm", "label": "Timestamp"},
              {"name": "type", "type": "alarm", "label": "Alarm Type"},
              {"name": "severity", "type": "alarm", "label": "Severity"},
              {"name": "status", "type": "alarm", "label": "Status"}
            ]
          }
        }
      }
    }
  }
}
