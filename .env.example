# ============================================================================
# Environment Variables Template (.env.example)
# Copy to .env and fill in real credentials before connecting to live CoreIOT
# NEVER commit .env to GitHub!
# ============================================================================

# --- CoreIOT Cloud Platform (app.coreiot.io) ---
COREIOT_HOST=app.coreiot.io
COREIOT_PORT=1883
COREIOT_USE_TLS=false
# Gateway device Access Token (Device with IsGateway = true on CoreIOT)
COREIOT_GATEWAY_TOKEN=REPLACE_WITH_YOUR_COREIOT_GATEWAY_ACCESS_TOKEN

# --- Telegram Bot Alerting (T13) ---
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_FAMILY_GROUP_CHAT_ID

# --- Local Gateway Mode (T08) ---
# source_mode: "simulator" (no hardware needed) or "serial" (real YoloUNO #2 on USB COM port)
GATEWAY_SOURCE_MODE=simulator
SERIAL_PORT=COM4
SERIAL_BAUDRATE=115200
SIMULATOR_TCP_HOST=127.0.0.1
SIMULATOR_TCP_PORT=19550
